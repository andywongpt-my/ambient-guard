# Ambient Guard — environment configuration (copy to .env; never commit .env)

# --- Bee integration ---
# cli = shell out to local `bee` CLI (live)  | mcp = talk to `bee mcp serve` | mock = fixtures (tests/dev only)
# Dev machine has a verified `bee login` (see evidence/M1_bee_login.md) — use cli for live runs. CI uses mock.
AMBIENT_GUARD_BEE_MODE=cli
# Only for AMBIENT_GUARD_BEE_MODE=mcp with the HTTP transport (bee mcp serve-http). Must be >=32 chars.
AMBIENT_GUARD_BEE_HTTP_TOKEN=
# MCP HTTP endpoint when using serve-http (bound to 127.0.0.1)
AMBIENT_GUARD_BEE_MCP_URL=http://127.0.0.1:8790/mcp

# --- Location fallback (used when Bee location unavailable; R3) ---
# "lat,lon" or a place name resolvable by the geocoder
AMBIENT_GUARD_DEFAULT_LOCATION=

# --- Environmental providers ---
# Open-Meteo needs NO key. Set these only if you swap in a keyed provider.
OPENAQ_API_KEY=
# Optional pollen/other keyed providers
POLLEN_API_KEY=

# --- Backend / DB ---
AMBIENT_GUARD_API_HOST=0.0.0.0
AMBIENT_GUARD_API_PORT=8080
DATABASE_URL=postgresql+psycopg://ambient:ambient@db:5432/ambient_guard
POSTGRES_USER=ambient
POSTGRES_PASSWORD=ambient
POSTGRES_DB=ambient_guard

# --- Reasoning (optional LLM synthesis) ---
AMBIENT_GUARD_LLM_PROVIDER=
AMBIENT_GUARD_LLM_API_KEY=
